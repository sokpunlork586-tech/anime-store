PROJECT_NAME="Anime Store API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/anime_store_db

# Security & JWT
SECRET_KEY=change_me_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:3002","http://localhost:5173"]

# First Admin Seed
FIRST_ADMIN_EMAIL=admin@animestore.com
FIRST_ADMIN_PASSWORD=Admin123456!
FIRST_ADMIN_NAME=Admin

# Telegram Notification (Optional)
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_admin_chat_id
TELEGRAM_ENABLED=true
