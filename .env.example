PROJECT_NAME="Anime Store API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database (PostgreSQL or SQLite fallback: sqlite+aiosqlite:///./anime_store.db)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/anime_store_db

# Security & JWT
SECRET_KEY=change_me_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# CORS (Frontend & Admin Dashboard)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:3002","http://localhost:5173"]

# First Admin Seed
FIRST_ADMIN_EMAIL=admin@animestore.com
FIRST_ADMIN_PASSWORD=change_me_in_production
FIRST_ADMIN_NAME=Admin

# Telegram Notification (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=false

# Firebase Authentication (Web App config from Firebase Console)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
