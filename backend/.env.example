PROJECT_NAME="Anime Store API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database
# Default to PostgreSQL. If postgres is unavailable, aiosqlite fallback can be used: sqlite+aiosqlite:///./anime_store.db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/anime_store_db

# Security & JWT
SECRET_KEY=anime_store_super_secure_production_secret_key_change_me_987654321
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# CORS (Frontend & Admin Dashboard)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:3002","http://localhost:5173"]

# First Admin Seed
FIRST_ADMIN_EMAIL=admin@animestore.com
FIRST_ADMIN_PASSWORD=Admin123456!
FIRST_ADMIN_NAME=Admin
